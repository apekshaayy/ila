# Lambda/Ollama configuration (example values only; never put a real key here)
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
OLLAMA_SECRET_NAME=ila/ollama_api_key
EVENT_BUS_NAME=ila-event-bus
MAX_CHARS=8000
CONFIDENCE_THRESHOLD=0.70
OLLAMA_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
OLLAMA_AUTH_MODE=secrets_manager
API_ALLOWED_ORIGIN=http://localhost:5173
PUBLISH_HTTP_EVENTS=true

# Local script only. Leave empty for a local Ollama server without authentication.
OLLAMA_API_KEY=
